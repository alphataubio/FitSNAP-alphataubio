
# -----------------------------------------------------------------------------
[UF3]
type = W
degree = 2
knot_strategy = linear
#r_min = 1
#r_max = 5.5

r_min_map_json = {("W", "W"): 1, ("W", "W", "W"): [1,1,1]}
r_max_map_json = {("W", "W"): 8.5, ("W", "W", "W"): [4.25,4.25,8.5]}
resolution_map_json = {("W", "W"): 10, ("W", "W", "W"): [10,10,20]}

bzeroflag = 0



# -----------------------------------------------------------------------------
[ESHIFT]
W = 0.0


# -----------------------------------------------------------------------------
[CALCULATOR]
calculator = LAMMPSUF3
energy = 1
force  = 1
stress = 1


# -----------------------------------------------------------------------------
[SOLVER]
solver = SLATE
compute_testerrs = 1


# -----------------------------------------------------------------------------
[SLATE]

method = RIDGE
alpha = 1e-8

#method = ARD
threshold_lambda = 1e99


# -----------------------------------------------------------------------------
[SCRAPER]
scraper = xyz
#max_configs_per_rank = 2

[PATH]
dataPath = XYZ


# -----------------------------------------------------------------------------
[REFERENCE]
units = metal
atom_style = atomic
pair_style = zero 8.5
pair_coeff = * *


# -----------------------------------------------------------------------------
[OUTFILE]
output_style = UF3
metrics = W_UF3.md
potential = W_UF3
validation = 1


# -----------------------------------------------------------------------------
[GROUPS]

# NOTE: training_size and testing_size are not specified since omat24 dataset
# already provides training/validation split in separate train/val archives.
# [https://huggingface.co/datasets/facebook/OMAT24]

group_sections  = name training_size testing_size eweight fweight vweight
group_types     = str  float         float        float   float   float
smartweights    = 0
random_sampling = 0
W_14_full            =      0.8           0.2          1     1     1e-12
#W_14            =      0.8           0.2          1     100     1e-12


# -----------------------------------------------------------------------------
[EXTRAS]
dump_descriptors = 0
dump_truth = 0
dump_weights = 0
debug = 0


# -----------------------------------------------------------------------------


###############################################################################
#
# OMAT=https://dl.fbaipublicfiles.com/opencatalystproject/data/omat
# wget -c -P train $OMAT/241018/omat/train/{rattled-{1000,500,300},aimd-from-PBE-{1000,3000}-{npt,nvt},rattled-relax}.tar.gz
# wget -c -P val $OMAT/241220/omat/val/{rattled-{1000,500,300},aimd-from-PBE-{1000,3000}-{npt,nvt},rattled-relax}.tar.gz
#
# clear; mpirun -np 192 python -m fitsnap3 AlNi_PYACE_SLATE_ARD.in --overwrite
#
###############################################################################


[PYACE]
elements = Al Ni
bzeroflag = 0

embeddings = {
    "Al": {"npot": "FinnisSinclair", "fs_parameters": [1, 1], "ndensity": 1},
    "Ni": {"npot": "FinnisSinclair", "fs_parameters": [1, 1], "ndensity": 1}
  }


bonds = {
    "AlAl": {"radbase": "ChebExpCos", "radparameters": [0.342],
             "rcut": 6.832, "dcut": 0.01, "core-repulsion": [0, 0.342], "r_in": 0.625, "delta_in": 0.01},
    "AlNi": {"radbase": "ChebExpCos", "radparameters": [0.318],
             "rcut": 6.356, "dcut": 0.01, "core-repulsion": [0, 0.318], "r_in": 0.650, "delta_in": 0.01},
    "NiNi": {"radbase": "ChebExpCos", "radparameters": [0.281],
             "rcut": 5.610, "dcut": 0.01, "core-repulsion": [0, 0.281], "r_in": 0.540, "delta_in": 0.01}
  }

functions = {
    "ALL": {"lmin_by_orders": [0,0,0,0], "lmax_by_orders": [1,1,1,1], "nradmax_by_orders": [20,5,3,1]}
    #"ALL": {"lmin_by_orders": [0,0], "lmax_by_orders": [1,1], "nradmax_by_orders": [8,2]}
  }

[CALCULATOR]
calculator = LAMMPSPYACE
energy = 1
force = 1
stress = 0

[REFERENCE]
units = real
atom_style = atomic
pair_style = hybrid/overlay zero 6.842222 zbl 4.782556 5.465778 zbl 4.448889 5.084444 zbl 3.927000 4.488000
pair_coeff1 = * * zero
pair_coeff2 = 1 1 zbl 1    13 13
pair_coeff3 = 1 2 zbl 2    13 28
pair_coeff4 = 2 2 zbl 3    28 28


[SOLVER]
solver = SLATE
compute_testerrs = 1
detailed_errors = 0

[SLATE]
#method = RIDGE
#alpha = 1e-9
method = ARD
pruning_method = lambda
scap = 1e-3
scai = 1e-3
max_iter = 10
threshold_lambda = 1.0

[SCRAPER]
scraper = ADIOS2

[PATH]
dataPath = omat24_AlNi.bp

###############################################################################
# NOTE: training_size and testing_size are not specified since omat24 dataset
# already provides training/validation split in separate train/val archives.
# [https://huggingface.co/datasets/facebook/OMAT24]
###############################################################################

[GROUPS]
group_sections = name eweight fweight vweight
group_types = str float float float float float
smartweights = 1
random_sampling = 0
rattled-300             = 1.0  100.0  1e-12
rattled-500             = 1.0  100.0  1e-12
rattled-1000            = 1.0  100.0  1e-12
rattled-relax           = 1.0  100.0  1e-12
aimd-from-PBE-1000-npt  = 1.0  100.0  1e-12
aimd-from-PBE-1000-nvt  = 1.0  100.0  1e-12
aimd-from-PBE-3000-npt  = 1.0  100.0  1e-12
aimd-from-PBE-3000-nvt  = 1.0  100.0  1e-12


[OUTFILE]
output_style = PACE
metrics = AlNi_PYACE_SLATE_ARD.md
potential = AlNi_PYACE_SLATE_ARD
validation = 1

[EXTRAS]
dump_descriptors = 0
dump_truth = 0
dump_weights = 0
debug = 0

[MEMORY]
override = 0

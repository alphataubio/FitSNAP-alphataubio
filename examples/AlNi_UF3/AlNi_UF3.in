

# -----------------------------------------------------------------------------
[UF3]
type = Al Ni
degree = 3
knot_strategy = linear


r_min_map_json = {("Al", "Ni"): 0, ("Al", "Ni", "Ni"): [1,1,1]}
r_max_map_json = {("Al", "Ni"): 8.5, ("Al", "Ni", "Ni"): [4.25,4.25,8.5]}
resolution_map_json = {("Al", "Ni"): 15, ("Al", "Ni", "Ni"): [5,5,10]}

bzeroflag = 0


# -----------------------------------------------------------------------------
[CALCULATOR]
calculator = LAMMPSUF3
energy = 1    # goal < 1.64 meV/atom
force  = 0    # goal < 28 meV/A
stress = 1    # goal < 0.09 GPa


# -----------------------------------------------------------------------------
[SOLVER]
solver = SLATE
compute_testerrs = 1


# -----------------------------------------------------------------------------
[SLATE]
method = RIDGE
alpha = 1e-6


# -----------------------------------------------------------------------------
[SCRAPER]
scraper = ADIOS2
#max_configs_per_rank = 100


# -----------------------------------------------------------------------------

# python ~/github/FitSNAP-alphataubio/tools/fairchem_to_adios2.py --dataset omat24 --elements Al Ni --output omat24_AlNi.bp

[PATH]
dataPath = ../AlNi_PYACE_SLATE_ARD/omat24_AlNi.bp


# -----------------------------------------------------------------------------
[REFERENCE]
units = metal
atom_style = atomic
pair_style = zero 5.0
pair_coeff = * *


# -----------------------------------------------------------------------------
[OUTFILE]
output_style = UF3
metrics = AlNi_UF3_SLATE_RIDGE.md
potential = AlNi_UF3_SLATE_RIDGE
validation = 1


# -----------------------------------------------------------------------------
[GROUPS]

# NOTE: training_size and testing_size are not specified since omat24 dataset
# already provides training/validation split in separate train/val archives.
# [https://huggingface.co/datasets/facebook/OMAT24]

group_sections = name                     eweight fweight vweight
group_types =    str                      float   float   float
smartweights = 1
rattled-300            = 1.0     100.0   10.0
rattled-500            = 1.0     100.0   10.0
rattled-1000           = 1.0     100.0   10.0
rattled-relax          = 1.0     100.0   10.0
aimd-from-PBE-1000-npt = 1.0     100.0   10.0
aimd-from-PBE-1000-nvt = 1.0     100.0   10.0
aimd-from-PBE-3000-npt = 1.0     100.0   10.0
aimd-from-PBE-3000-nvt = 1.0     100.0   10.0


# -----------------------------------------------------------------------------
[EXTRAS]
dump_descriptors = 0
dump_truth = 0
dump_weights = 0
debug = 0


# -----------------------------------------------------------------------------

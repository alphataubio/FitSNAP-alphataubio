

# -----------------------------------------------------------------------------
[UF3]
type = Al Ni
degree = 3
knot_strategy = linear

resolution = 8

r_min_map_json = {("Al", "Ni"): 0.5, ("Al", "Ni", "Ni"): [0.5,0.5,0.5]}
#r_max_map_json = {("Al", "Ni"): 5, ("Al", "Ni", "Ni"): [5,5,10]}
#resolution_map_json = {
#    ("Al", "Al"): 15, ("Al", "Ni"): 15, ("Ni", "Ni"): 15,
#    ("Al","Al","Al"): [10,10,10], ("Al","Al","Ni"): [10,10,10], ("Al","Ni","Ni"): [10,10,10], ("Ni","Al","Al"): [10,10,10], ("Ni","Al","Ni"): [10,10,10], ("Ni","Ni","Ni"): [10,10,10],
#  }

bzeroflag = 0


# -----------------------------------------------------------------------------
[CALCULATOR]
calculator = LAMMPSUF3
energy = 1    # goal < 1.64 meV/atom
force  = 1    # goal < 28 meV/A
stress = 0    # goal < 0.09 GPa


# -----------------------------------------------------------------------------
[SOLVER]
solver = SLATE
compute_testerrs = 1


# -----------------------------------------------------------------------------
[SLATE]

method = RIDGE
alpha = 1e-8

#method = ARD
#scap = 1e6
#scai = 1e6

directmethod = 1
alphabig = 1e-2
alphasmall = 1e-4
lambdabig = 1e-2
lambdasmall = 1e-4
max_iter = 20
threshold_lambda = 1e99


# -----------------------------------------------------------------------------
[SCRAPER]
scraper = ADIOS2
max_configs_per_rank = 100
auto_eshift = 1


# -----------------------------------------------------------------------------

# python ~/github/FitSNAP-alphataubio/tools/fairchem_to_adios2.py --dataset omat24 --elements Al Ni --output omat24_AlNi.bp

[PATH]
dataPath = ../AlNi_PYACE_SLATE_ARD/omat24_AlNi.bp


# -----------------------------------------------------------------------------
[REFERENCE]
units = metal
atom_style = atomic
pair_style = zero 5.0
pair_coeff = * *


# -----------------------------------------------------------------------------
[OUTFILE]
output_style = UF3
metrics = AlNi_UF3.md
potential = AlNi_UF3
validation = 1


# -----------------------------------------------------------------------------
[GROUPS]

# NOTE: training_size and testing_size are not specified since omat24 dataset
# already provides training/validation split in separate train/val archives.
# [https://huggingface.co/datasets/facebook/OMAT24]

group_sections = name                     eweight fweight vweight
group_types =    str                      float   float   float
smartweights = 1
rattled-300            = 1     100   1e-12
rattled-500            = 1     100   1e-12
rattled-1000           = 1     100   1e-12
rattled-relax          = 1     100   1e-12
aimd-from-PBE-1000-npt = 1     100   1e-12
aimd-from-PBE-1000-nvt = 1     100   1e-12
aimd-from-PBE-3000-npt = 1     100   1e-12
aimd-from-PBE-3000-nvt = 1     100   1e-12


# -----------------------------------------------------------------------------
[EXTRAS]
dump_descriptors = 0
dump_truth = 0
dump_weights = 0
debug = 0


# -----------------------------------------------------------------------------

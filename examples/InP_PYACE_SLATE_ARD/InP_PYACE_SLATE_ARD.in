
# -----------------------------------------------------------------------------
[PYACE]
elements = In P

embeddings = {
    "In": {"npot": "FinnisSinclair", "fs_parameters": [1, 1], "ndensity": 1},
    "P": {"npot": "FinnisSinclair", "fs_parameters": [1, 1], "ndensity": 1}
  }

# rcutfac = 5.790  5.007  5.007  4.224
# lambda = 1.737  1.502  1.502  1.267
# rcinner = 1.705  1.403  1.403  1.100
# drcinner = 0.01 0.01 0.01 0.01

bonds = {
    "In In": {"radbase": "ChebExpCos", "radparameters": [1.737],
             "rcut": 5.790, "dcut": 0.01, "core-repulsion": [0,1.737], "rcut_in": 1.705, "dcut_in": 0.01},
    "P In":  {"radbase": "ChebExpCos", "radparameters": [1.502],
             "rcut": 5.007, "dcut": 0.01, "core-repulsion": [0,1.502], "rcut_in": 1.403, "dcut_in": 0.01},
    "P P":   {"radbase": "ChebExpCos", "radparameters": [1.267],
             "rcut": 4.224, "dcut": 0.01, "core-repulsion": [0,1.267], "rcut_in": 1.100, "dcut_in": 0.01}
  }

# ranks = 1 2 3 4
# lmin = 0 0 1 1
# lmax =  1 2 2 1
# nmax =  22 3 2 1

functions = {
    "ALL": { "nmax_by_rank": [22,3,2,1], "lmin_by_rank": [0,0,1,1], "lmax_by_rank": [1,2,2,1] }
  }

bzeroflag = 0

# -----------------------------------------------------------------------------
[CALCULATOR]
calculator = LAMMPSPYACE
energy = 1
force = 1
stress = 1

# -----------------------------------------------------------------------------
[ESHIFT]
In = -1.65967588701534
P = 4.38159549501534

# -----------------------------------------------------------------------------
[SOLVER]
solver = SLATE
compute_testerrs = 1

# -----------------------------------------------------------------------------
[SLATE]
method = ARD
max_iter = 20
scap = 1e-6
scai = 1e-6
threshold_lambda = 3.16227766017  # = 10^0.5

# -----------------------------------------------------------------------------
[SCRAPER]
scraper = JSON

# -----------------------------------------------------------------------------
[PATH]
dataPath = ../InP_JPCA2020/JSON

# -----------------------------------------------------------------------------
[OUTFILE]
output_style = PACE
metrics = InP_PYACE_SLATE_ARD.md
potential = InP_PYACE_SLATE_ARD
validation = 1

# -----------------------------------------------------------------------------
[REFERENCE]
units = metal
atom_style = atomic
pair_style = zero 5.8
pair_coeff = * *

# -----------------------------------------------------------------------------
[GROUPS]
group_sections = name training_size testing_size eweight fweight vweight
group_types = str float float float float float
smartweights = 1
random_sampling = 0
aa     =     0.95      0.05      1.0000    100.0000      1e-6
aIn    =     0.95      0.05      1.0000    100.0000      1e-6
aP     =     0.95      0.05      1.0000    100.0000      1e-6
Bulk   =     0.95      0.05      1.0000      0.0010      1e-6
EOS    =     0.95      0.05     40.0000    100.0000      1e-6
iIn    =     0.95      0.05      2.0000    100.0000      1e-6
iP     =     0.95      0.05      2.0000    100.0000      1e-6
s_aa   =     0.95      0.05     10.0000    100.0000      1e-6
s_aIn  =     0.95      0.05     10.0000    100.0000      1e-6
s_aP   =     0.95      0.05     10.0000    200.0000      1e-6
Shear  =     0.95      0.05     22.0000    100.0000      1e-6
s_iIn  =     0.95      0.05     10.0000    300.0000      1e-6
s_iP   =     0.95      0.05     10.0000    300.0000      1e-6
Strain =     0.95      0.05     13.0000      0.0010      1e-6
s_vIn  =     0.95      0.05     10.0000    100.0000      1e-6
s_vP   =     0.95      0.05      1.0000    100.0000      1e-6
s_vv   =     0.95      0.05      1.0000    100.0000      1e-6
vP     =     0.95      0.05      1.0000    100.0000      1e-6

# -----------------------------------------------------------------------------
[EXTRAS]
dump_descriptors = 0
dump_truth = 0
dump_weights = 0
dump_dataframe = 0
debug = 0
multinode_testing = 1

